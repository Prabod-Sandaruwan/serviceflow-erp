// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  LOST
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  OTHER
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum RecordStatus {
  ACTIVE
  VOIDED
}

enum ExpenseCategory {
  SOFTWARE_LICENSE
  HOSTING_INFRASTRUCTURE
  THIRD_PARTY_SERVICE
  TRAVEL
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
}

model Employee {
  id            BigInt   @id @default(autoincrement())
  full_name     String
  job_title     String?
  department    String?
  phone         String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User?
  assignedTasks Task[]   @relation("TaskAssignee")

  @@map("employees")
}

model User {
  id                   BigInt      @id @default(autoincrement())
  email                String      @unique
  password_hash        String
  role                 Role        @default(STAFF)
  employee_id          BigInt?     @unique
  is_active            Boolean     @default(true)
  must_change_password Boolean     @default(true)
  last_login_at        DateTime?
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt
  employee             Employee?   @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  leads                Lead[]
  follow_ups           FollowUp[]
  createdQuotations    Quotation[] @relation("QuotationCreator")
  approvedQuotations   Quotation[] @relation("QuotationApprover")
  createdProjects      Project[]   @relation("ProjectCreator")
  approvedMilestones   Milestone[] @relation("MilestoneApprover")
  createdTasks         Task[]      @relation("TaskCreator")
  createdInvoices      Invoice[]   @relation("InvoiceCreator")
  issuedInvoices       Invoice[]   @relation("InvoiceIssuer")
  cancelledInvoices    Invoice[]   @relation("InvoiceCanceller")
  recordedPayments     Payment[]   @relation("PaymentRecorder")
  voidedPayments       Payment[]   @relation("PaymentVoider")
  recordedExpenses     Expense[]   @relation("ExpenseRecorder")
  voidedExpenses       Expense[]   @relation("ExpenseVoider")
  auditLogs            AuditLog[]  @relation("AuditActor")

  @@index([role])
  @@map("users")
}

model Client {
  id                  BigInt      @id @default(autoincrement())
  client_type         ClientType  @default(COMPANY)
  display_name        String
  email               String?
  phone               String?
  address             String?     @db.Text
  registration_number String?
  notes               String?     @db.Text
  is_active           Boolean     @default(true)
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  lead                Lead?
  quotations          Quotation[]
  projects            Project[]

  @@index([display_name])
  @@index([email])
  @@map("clients")
}

model Lead {
  id                  BigInt      @id @default(autoincrement())
  owner_id            BigInt
  owner               User        @relation(fields: [owner_id], references: [id], onDelete: Restrict)
  status              LeadStatus  @default(NEW)
  lost_reason         String?
  expected_value      Decimal?    @db.Decimal(14, 2)
  converted_client_id BigInt?     @unique
  converted_client    Client?     @relation(fields: [converted_client_id], references: [id], onDelete: SetNull)
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  follow_ups          FollowUp[]
  quotations          Quotation[]

  @@map("leads")
}

model FollowUp {
  id                  BigInt         @id @default(autoincrement())
  lead_id             BigInt
  lead                Lead           @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  follow_up_date      DateTime
  type                FollowUpType
  status              FollowUpStatus @default(SCHEDULED)
  next_follow_up_date DateTime?
  created_by          BigInt
  creator             User           @relation(fields: [created_by], references: [id], onDelete: Restrict)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  @@index([lead_id, follow_up_date])
  @@map("follow_ups")
}

model Quotation {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  quotationNumber String          @unique @map("quotation_number") @db.VarChar(20)
  clientId        BigInt          @map("client_id") @db.UnsignedBigInt
  leadId          BigInt?         @map("lead_id") @db.UnsignedBigInt
  revisionOfId    BigInt?         @map("revision_of_id") @db.UnsignedBigInt
  title           String          @db.VarChar(160)
  status          QuotationStatus @default(DRAFT)
  quotationDate   DateTime        @map("quotation_date") @db.Date
  validUntil      DateTime        @map("valid_until") @db.Date
  subtotal        Decimal         @default(0) @db.Decimal(14, 2)
  taxType         String?         @map("tax_type") @db.VarChar(20)
  taxRate         Decimal?        @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  taxReference    String?         @map("tax_reference") @db.VarChar(60)
  total           Decimal         @db.Decimal(14, 2)
  createdBy       BigInt          @map("created_by") @db.UnsignedBigInt
  submittedAt     DateTime?       @map("submitted_at") @db.DateTime(3)
  approvedBy      BigInt?         @map("approved_by") @db.UnsignedBigInt
  decidedAt       DateTime?       @map("decided_at") @db.DateTime(3)
  rejectionReason String?         @map("rejection_reason") @db.VarChar(500)
  sentAt          DateTime?       @map("sent_at") @db.DateTime(3)
  respondedAt     DateTime?       @map("responded_at") @db.DateTime(3)
  responseNote    String?         @map("response_note") @db.VarChar(500)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  client     Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  revisionOf Quotation?      @relation("QuotationRevisions", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisions  Quotation[]     @relation("QuotationRevisions")
  creator    User            @relation("QuotationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver   User?           @relation("QuotationApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  project    Project?

  @@index([status, createdBy])
  @@index([clientId])
  @@map("quotations")
}

model QuotationItem {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  quotationId BigInt  @map("quotation_id") @db.UnsignedBigInt
  lineNo      Int     @map("line_no") @db.UnsignedSmallInt
  description String  @db.VarChar(255)
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  lineAmount  Decimal @map("line_amount") @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  @@unique([quotationId, lineNo])
  @@index([quotationId])
  @@map("quotation_items")
}

model Project {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  projectCode  String        @unique @map("project_code") @db.VarChar(20)
  quotationId  BigInt        @unique @map("quotation_id") @db.UnsignedBigInt
  clientId     BigInt        @map("client_id") @db.UnsignedBigInt
  name         String        @db.VarChar(160)
  description  String?       @db.Text
  status       ProjectStatus @default(PLANNED)
  startDate    DateTime?     @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  budgetAmount Decimal       @map("budget_amount") @db.Decimal(14, 2)
  cancelReason String?       @map("cancel_reason") @db.VarChar(500)
  createdBy    BigInt        @map("created_by") @db.UnsignedBigInt
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  quotation  Quotation   @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  creator    User        @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  milestones Milestone[]
  tasks      Task[]
  invoices   Invoice[]
  expenses   Expense[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model Milestone {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  projectId     BigInt          @map("project_id") @db.UnsignedBigInt
  name          String          @db.VarChar(160)
  description   String?         @db.Text
  sortOrder     Int             @default(0) @map("sort_order") @db.UnsignedSmallInt
  status        MilestoneStatus @default(PENDING)
  billingAmount Decimal         @map("billing_amount") @db.Decimal(14, 2)
  dueDate       DateTime?       @map("due_date") @db.Date
  completedAt   DateTime?       @map("completed_at") @db.DateTime(3)
  approvedBy    BigInt?         @map("approved_by") @db.UnsignedBigInt
  approvedAt    DateTime?       @map("approved_at") @db.DateTime(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approver User?     @relation("MilestoneApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  tasks    Task[]
  invoices Invoice[]

  @@index([projectId])
  @@index([status])
  @@map("milestones")
}

model Task {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  projectId   BigInt       @map("project_id") @db.UnsignedBigInt
  milestoneId BigInt?      @map("milestone_id") @db.UnsignedBigInt
  title       String       @db.VarChar(160)
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?    @map("due_date") @db.Date
  assigneeId  BigInt?      @map("assignee_id") @db.UnsignedBigInt
  createdBy   BigInt       @map("created_by") @db.UnsignedBigInt
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  assignee  Employee?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator   User       @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([assigneeId, status])
  @@index([projectId, status])
  @@map("tasks")
}

model Invoice {
  id                 BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceNumber      String        @unique @map("invoice_number") @db.VarChar(20)
  projectId          BigInt        @map("project_id") @db.UnsignedBigInt
  milestoneId        BigInt        @map("milestone_id") @db.UnsignedBigInt
  activeMilestoneKey BigInt?       @unique @map("active_milestone_key") @db.UnsignedBigInt
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime?     @map("issue_date") @db.Date
  dueDate            DateTime?     @map("due_date") @db.Date
  subtotal           Decimal       @db.Decimal(14, 2)
  taxType            String?       @map("tax_type") @db.VarChar(20)
  taxRate            Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  taxReference       String?       @map("tax_reference") @db.VarChar(60)
  total              Decimal       @db.Decimal(14, 2)
  notes              String?       @db.Text
  createdBy          BigInt        @map("created_by") @db.UnsignedBigInt
  issuedBy           BigInt?       @map("issued_by") @db.UnsignedBigInt
  issuedAt           DateTime?     @map("issued_at") @db.DateTime(3)
  cancelledBy        BigInt?       @map("cancelled_by") @db.UnsignedBigInt
  cancelledAt        DateTime?     @map("cancelled_at") @db.DateTime(3)
  cancelReason       String?       @map("cancel_reason") @db.VarChar(500)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  creator   User          @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  issuer    User?         @relation("InvoiceIssuer", fields: [issuedBy], references: [id], onDelete: Restrict)
  canceller User?         @relation("InvoiceCanceller", fields: [cancelledBy], references: [id], onDelete: Restrict)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([status, dueDate])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceId   BigInt  @map("invoice_id") @db.UnsignedBigInt
  lineNo      Int     @map("line_no") @db.UnsignedSmallInt
  description String  @db.VarChar(255)
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  lineAmount  Decimal @map("line_amount") @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceId      BigInt        @map("invoice_id") @db.UnsignedBigInt
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  paymentDate    DateTime      @map("payment_date") @db.Date
  reference      String?       @db.VarChar(80)
  note           String?       @db.VarChar(500)
  status         RecordStatus  @default(ACTIVE)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(64)
  recordedBy     BigInt        @map("recorded_by") @db.UnsignedBigInt
  voidedBy       BigInt?       @map("voided_by") @db.UnsignedBigInt
  voidedAt       DateTime?     @map("voided_at") @db.DateTime(3)
  voidReason     String?       @map("void_reason") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recorder User    @relation("PaymentRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  voider   User?   @relation("PaymentVoider", fields: [voidedBy], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@index([paymentDate])
  @@map("payments")
}

model Expense {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  projectId   BigInt          @map("project_id") @db.UnsignedBigInt
  category    ExpenseCategory
  description String          @db.VarChar(255)
  supplier    String?         @db.VarChar(120)
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @map("expense_date") @db.Date
  status      RecordStatus    @default(ACTIVE)
  recordedBy  BigInt          @map("recorded_by") @db.UnsignedBigInt
  voidedBy    BigInt?         @map("voided_by") @db.UnsignedBigInt
  voidedAt    DateTime?       @map("voided_at") @db.DateTime(3)
  voidReason  String?         @map("void_reason") @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recorder User    @relation("ExpenseRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  voider   User?   @relation("ExpenseVoider", fields: [voidedBy], references: [id], onDelete: Restrict)

  @@index([projectId, expenseDate])
  @@index([expenseDate])
  @@map("expenses")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorUserId BigInt?  @map("actor_user_id") @db.UnsignedBigInt
  actorRole   String?  @map("actor_role") @db.VarChar(20)
  action      String   @db.VarChar(60)
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    BigInt?  @map("entity_id") @db.UnsignedBigInt
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  requestId   String?  @map("request_id") @db.Char(36)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
