# Application Port (default: 3000)
PORT=3000

# Environment mode: development | production | test
NODE_ENV=development

# Frontend application URL (used for CORS single-origin validation)
FRONTEND_URL=http://localhost:5173

# Database connection URL (MySQL 8 with utf8mb4)
# Format: mysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql://serviceflow:<your_mysql_password>@localhost:3306/serviceflow_dev"

# Express Session secret key (minimum 32 characters in production)
SESSION_SECRET="your_secure_random_session_secret_min_32_chars_here!"

# Cookie Security flag (true in production with HTTPS, false for local HTTP)
COOKIE_SECURE=false

# Company Profile Configuration (displayed on PDF headers and financial reports)
COMPANY_NAME="ServiceFlow Technologies (Pvt) Ltd"
COMPANY_ADDRESS="No. 123, Galle Road, Colombo 03, Sri Lanka"
COMPANY_PHONE="+94 11 234 5678"
COMPANY_EMAIL="info@serviceflow.lk"
COMPANY_WEBSITE="https://serviceflow.lk"
