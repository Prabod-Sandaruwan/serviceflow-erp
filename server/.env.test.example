# Isolated test database URL (must end in _test to pass test guard)
DATABASE_URL="mysql://serviceflow:<your_mysql_password>@localhost:3306/serviceflow_test"

# Test Server Port
PORT=3001

# Test Environment Mode
NODE_ENV="test"

# Test Session Secret
SESSION_SECRET="test_super_secret_session_key_min_32_chars_long!"

# Frontend URL / CORS Origin for test client requests
FRONTEND_URL="http://localhost:5173"
